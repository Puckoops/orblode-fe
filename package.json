{
  "name": "orblode-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3100",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 next build --webpack",
    "start": "next start -p 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/lib/**/*.test.ts\"",
    "landing:capture": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/landing/capture.ts",
    "landing:encode": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/landing/encode.ts",
    "postinstall": "mkdir -p public/cesium && cp -R node_modules/cesium/Build/Cesium/* public/cesium/"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@puckoops/camelot": "file:vendor/puckoops-camelot-0.2.0.tgz",
    "@xstate/react": "^6.1.0",
    "cesium": "^1.141.0",
    "framer-motion": "^12.40.0",
    "geotiff": "^3.0.5",
    "next": "16.3.8",
    "proj4": "^2.20.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resium": "^1.22.0",
    "server-only": "^0.0.1",
    "shpjs": "^6.1.0",
    "xstate": "^5.32.5",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/proj4": "^2.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright-core": "^1.56.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
