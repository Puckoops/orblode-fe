# user-svc's API base, without a trailing slash: accounts, sessions and the /orblode/* domain endpoints.
USER_SVC_URL="http://127.0.0.1:18080/user-svc-smm/api/v1"

# orblode-svc's API base, without a trailing slash: surveys, manifests, measurements, folders and the files proxy.
ORBLODE_SVC_URL="http://127.0.0.1:18082/orblode-svc/api/v1"

# Cesium ion access token for World Terrain and the Digital Twin layer. Public: it reaches the browser bundle.
NEXT_PUBLIC_CESIUM_ION_TOKEN=""

# The OAuth client behind "Sign in with Google", the same one user-svc's GOOGLE_CLIENT_ID names. Public: it
# reaches the browser bundle. Empty hides the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
